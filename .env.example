# ==============================================================================
# CONFIGURAÇÃO DE SEGURANÇA (EXEMPLO)
#
# ATENÇÃO: NÃO suba este arquivo preenchido (.env) para o GitHub!
# Em repositórios públicos, cadastre estas variáveis na aba:
# Settings > Secrets and variables > Actions > New repository secret
# ==============================================================================

# Credenciais da sua conta no AnkiWeb (usadas para sincronizar seus baralhos)
ANKIWEB_USER=seu_email@exemplo.com
ANKIWEB_PASSWORD=sua_senha_do_ankiweb

# Credenciais do Ngrok (para expor a porta 3141 na nuvem)
NGROK_AUTHTOKEN=seu_token_ngrok_aqui
NGROK_DOMAIN=seu-dominio-estatico.ngrok-free.dev

# Chave secreta de proteção do Anki MCP Server (evita acessos não autorizados)
ANKI_MCP_API_KEY=sua_chave_secreta_aqui

# Duração padrão em minutos (caso nenhum valor seja passado pelo Composio / IA)
DEFAULT_DURATION_MINUTES=30
